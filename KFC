[Rule]
# 不依赖 MitM：HomePopService 使用 dynamicad.kfc.com.cn/api/app6/pop。
# 整个 dynamicad 域名也承载首页个性化广告与 AI 相关接口。
DOMAIN,dynamicad.kfc.com.cn,REJECT
# App 内含有以下弹窗 JSON 路径模板；按 HTTPS URL 路径过滤需要启用 MitM。
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/pop/index\.json(?:\?.*)?$,REJECT
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/pop/pop_[^/?]+\.json(?:\?.*)?$,REJECT

[MitM]
hostname = res.kfc.com.cn
