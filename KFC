[Rule]
# IPA 与 HAR 确认的动态首页弹窗 API。
DOMAIN,dynamicad.kfc.com.cn,REJECT
# KFC 首页弹窗 JSON。
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/pop/(?:index\.json|pop_[^/?]+\.json)(?:\?.*)?$,REJECT

[Script]
http-request ^https:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/(?:apphome6\/[^?]+\.json|bootStrap\/rn\/[^?]+\.json|notHomepage\/KFC\/rn\/[^?]+\.json) script-path=https://raw.githubusercontent.com/xingjiu29/KFC/refs/heads/main/kfc_home_request.js,tag=KFC广告底栏缓存绕过,timeout=20
http-response ^https:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/(?:apphome6\/[^?]+\.json|bootStrap\/rn\/[^?]+\.json|notHomepage\/KFC\/rn\/[^?]+\.json) script-path=https://raw.githubusercontent.com/xingjiu29/KFC/refs/heads/main/kfc_home_response.js,tag=KFC启动广告底栏清理,requires-body=true,timeout=20

[MitM]
hostname = res.kfc.com.cn
