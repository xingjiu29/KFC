#!tag = 肯德基,去广告,底栏

[Rule]
# 命中 IPA 中确认的首页弹窗 API。
DOMAIN,dynamicad.kfc.com.cn,REJECT
# 拦截弹窗 JSON 配置。
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/pop/(?:index\.json|pop_[^/?]+\.json)(?:\?.*)?$,REJECT

[Script]
http-request ^https:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/(?:apphome6\/apphome_[^?]+\.json|bootStrap\/(?:bootStrap_[^?]+\.json|rn)) script-path=https://raw.githubusercontent.com/xingjiu29/KFC/refs/heads/main/kfc_home_request.js,tag=KFC启动配置缓存绕过,timeout=20
http-response ^https:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/(?:apphome6\/apphome_[^?]+\.json|bootStrap\/(?:bootStrap_[^?]+\.json|rn)) script-path=https://raw.githubusercontent.com/xingjiu29/KFC/refs/heads/main/kfc_home_response.js,tag=KFC启动广告底栏清理,requires-body=true,timeout=20

[MitM]
hostname = res.kfc.com.cn
